#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/fakeflow run --config /etc/fakeflow.toml
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/fakeflow.toml
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits memlock="unlimited"
    procd_close_instance
}

reload_service() {
    /usr/sbin/fakeflow reload
}

service_triggers() {
    procd_add_reload_trigger fakeflow
}
