#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled
    config_load fakeflow
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    procd_open_instance
    # The daemon keeps its own output in this file (procd would otherwise forward
    # stdout and stderr to logd, burying the system log). Deliberately no
    # procd_set_param stdout/stderr: those flags are what send it to syslog.
    # A hard failure is still visible in syslog through procd's own instance
    # messages, and the daemon's own diagnostics are shown in LuCI → 日志.
    # --log-level info keeps routine libbpf detail (map/relocation, DEBUG) out of
    # the file; use debug when reproducing a load failure, because the verifier
    # dump is DEBUG as well.
    procd_set_param command /usr/sbin/fakeflow run --config /etc/fakeflow.toml --log-file /var/log/fakeflow.log --log-level info
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/fakeflow.toml
    procd_set_param limits memlock="unlimited"
    procd_close_instance
}

reload_service() {
    local enabled
    config_load fakeflow
    config_get_bool enabled main enabled 0
    if [ "$enabled" != 1 ]; then
        stop
    elif /usr/sbin/fakeflow status >/dev/null 2>&1; then
        /usr/sbin/fakeflow reload
    else
        start
    fi
}

service_triggers() {
    procd_add_reload_trigger fakeflow
}
